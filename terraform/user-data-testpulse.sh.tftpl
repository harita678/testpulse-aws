#!/bin/bash
#
# TestPulse — EC2 User Data Bootstrap Script
# Bootstraps BOTH services on this box: Ingestor (8000) + Dashboard (8001)
# Runs ONCE on first boot of an Amazon Linux 2023 EC2 instance
#

# ---------------------------------------------------------------------------
# Section 1: Logging — capture everything for debugging
# Redirect everything printed by the rest of user-data.sh into /var/log/user-data.log.
# ---------------------------------------------------------------------------
exec > /var/log/user-data.log 2>&1
set -x

echo "===== TestPulse Ingestor & Dashboard Bootstrap  starting at $(date) ====="

# ---------------------------------------------------------------------------
# Section 2: System update
# ---------------------------------------------------------------------------
echo "Updating system packages..."
dnf update -y

# ---------------------------------------------------------------------------
# Section 3: Install Docker (replaces Python — Python now lives in the images)
# ---------------------------------------------------------------------------
echo "Installing Docker..."
dnf install -y docker

# Start Docker and enable it so it survives reboots; herewe are asking systemctl to start the docker service

systemctl enable --now docker

# Let ec2-user run docker without sudo
usermod -aG docker ec2-user

# ---------------------------------------------------------------------------
# Section 4: Install git
# ---------------------------------------------------------------------------
echo "Installing git..."
dnf install -y git

# ---------------------------------------------------------------------------
# Section 5: Clone the repo (as ec2-user, not root)
# ---------------------------------------------------------------------------
echo "Cloning aws-lab repo..."
cd /home/ec2-user
sudo -u ec2-user git clone -b main https://github.com/harita678/aws-lab.git

# ---------------------------------------------------------------------------
# Section 6: Build both container images
# Python, pip, and all dependencies now live INSIDE the images —
# the box only needs Docker.
# ---------------------------------------------------------------------------

# Image for Ingestor
echo "Building Ingestor Image..."
cd /home/ec2-user/aws-lab/05-testpulse/ingestor
docker build -t testpulse-ingestor .

# Image for Dashboard
echo "Building Dashboard Image..."
cd /home/ec2-user/aws-lab/05-testpulse/dashboard
docker build -t testpulse-dashboard .

# ---------------------------------------------------------------------------
# Section 7a: Write .env file with config for Ingestor
# ---------------------------------------------------------------------------
echo "Writing Ingestor .env file..."
cat > /home/ec2-user/aws-lab/05-testpulse/ingestor/.env << 'EOF'
AWS_REGION=ca-central-1
S3_BUCKET_NAME=harita-testpulse-raw-2026
SQS_QUEUE_URL=https://sqs.ca-central-1.amazonaws.com/951125265513/harita-testpulse-ingestion-queue
EOF
chown ec2-user:ec2-user /home/ec2-user/aws-lab/05-testpulse/ingestor/.env


# ---------------------------------------------------------------------------
# Section 7b: Write .env file with config for Dashbaord
# ---------------------------------------------------------------------------
echo "Writing Dashboard .env file..."
cat > /home/ec2-user/aws-lab/05-testpulse/dashboard/.env << EOF
AWS_DEFAULT_REGION=ca-central-1
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USERNAME=${db_username}
DB_SECRET_ARN=${db_secret_arn}
EOF
chown ec2-user:ec2-user /home/ec2-user/aws-lab/05-testpulse/dashboard/.env

# ---------------------------------------------------------------------------
# Section 8a: Create systemd service file for Docker - Ingestor image; my app is containerized and the continer runs as a systemd service
# ---------------------------------------------------------------------------
echo "Creating Ingestor systemd service..."
cat > /etc/systemd/system/testpulse-ingestor.service << 'EOF'
[Unit]
Description=TestPulse Ingestor (container)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f testpulse-ingestor
ExecStart=/usr/bin/docker run --rm --name testpulse-ingestor \
  -p 8000:8000 \
  --env-file /home/ec2-user/aws-lab/05-testpulse/ingestor/.env \
  testpulse-ingestor
ExecStop=/usr/bin/docker stop testpulse-ingestor

[Install]
WantedBy=multi-user.target
EOF
# ---------------------------------------------------------------------------
# Section 8b: Create systemd service file for Docker - Dashboard image; my app is containerized and the continer runs as a systemd service
# ---------------------------------------------------------------------------
echo "Creating Dashboard systemd service..."
cat > /etc/systemd/system/testpulse-dashboard.service << 'EOF'
[Unit]
Description=TestPulse Dashboard (container)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=-/usr/bin/docker rm -f testpulse-dashboard
ExecStart=/usr/bin/docker run --rm --name testpulse-dashboard \
  -p 8001:8001 \
  --env-file /home/ec2-user/aws-lab/05-testpulse/dashboard/.env \
  testpulse-dashboard
ExecStop=/usr/bin/docker stop testpulse-dashboard

[Install]
WantedBy=multi-user.target
EOF
# ---------------------------------------------------------------------------
# Section 9a: Ingestor Enable + start the service
# ---------------------------------------------------------------------------
echo "Enabling and starting Ingestor service..."
systemctl daemon-reload
systemctl enable testpulse-ingestor
systemctl start testpulse-ingestor

# ---------------------------------------------------------------------------
# Section 9b: Dashboard Enable + start the service
# ---------------------------------------------------------------------------
echo "Enabling and starting Dashboard service..."
systemctl daemon-reload
systemctl enable testpulse-dashboard
systemctl start testpulse-dashboard

# ---------------------------------------------------------------------------
# Section 10a: Done; check service logs and app logs Ingestor
# ---------------------------------------------------------------------------
echo "===== TestPulse Ingestor bootstrap completed at $(date) ====="
echo "Check status: systemctl status testpulse-ingestor"
echo "Check logs:   journalctl -u testpulse-ingestor -f" # to check service log and app log

# ---------------------------------------------------------------------------
# Section 10b: Done, check service logs and app logs Dashboard
# ---------------------------------------------------------------------------
echo "===== TestPulse Dahsboard bootstrap completed at $(date) ====="
echo "Check status: systemctl status testpulse-dashboard"
echo "Check logs:   journalctl -u testpulse-dashboard -f" # to check service log and app log